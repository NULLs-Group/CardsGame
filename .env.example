# 🎮 CARDS GAME - Configuração de Ambiente
# Copie este arquivo para .env e personalize os valores

# Segurança
SECRET_KEY=cards-game-super-secret-2024-change-in-production

# Banco de Dados
DATABASE_URL=sqlite:///cardsgame.db

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# CORS
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=backend/uploads

# API
API_HOST=0.0.0.0
API_PORT=5000
